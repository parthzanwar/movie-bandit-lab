# Default: Apple's on-device Foundation Model. Requires macOS 26+ and Swift CLI Tools.
GENAI_PROVIDER=apple-foundation-model

# Optional alternative provider: openai-compatible
# Set GENAI_BASE_URL, GENAI_MODEL, and (for hosted services) GENAI_API_KEY.
GENAI_BASE_URL=http://localhost:11434/v1
GENAI_MODEL=
GENAI_API_KEY=
GENAI_TIMEOUT_SECONDS=75
